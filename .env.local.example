# AMP AI360 — Environment configuration
# Copy this file to `.env.local` and fill in the values you have.
# The platform works WITHOUT any keys (deterministic local RAG fallback),
# but adding a key enables higher-quality LLM-generated executive analysis.

# --- AI providers (optional; either one enables live LLM answers) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Make the in-dashboard "Ask AMP GPT" assistant answer like your ChatGPT custom
# GPT ("Tanzania AMP2050"). There is no API to call a named custom GPT directly,
# so paste that GPT's *Instructions* here and set OPENAI_API_KEY above — the
# assistant then calls OpenAI with the same persona so answers align closely.
# (Tip: open the GPT → Edit → Configure → copy the Instructions text.)
AMP_GPT_INSTRUCTIONS=

# --- Live government / open data source toggles (optional) ---
# When present, /api/data/metrics attempts these before falling back.
GOV_API_BASE_URL=
NBS_API_KEY=
TMX_API_KEY=
TRA_API_KEY=
# Public open-data endpoints used as tier-2 fallback (no key required):
#   FAOSTAT      https://fenixservices.fao.org/faostat/api/v1/en
#   World Bank   https://api.worldbank.org/v2
#   WFP VAM      https://api.vam.wfp.org
